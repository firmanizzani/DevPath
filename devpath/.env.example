# URL backend Elysia (bun run api/src/index.ts)
# Kosongkan untuk memakai data lokal yang dibundel di dalam aplikasi.
PUBLIC_API_URL=http://localhost:3001

# Supabase — Settings → API (Auth → anon/public)
# Dipakai untuk login/register, OAuth Google, dan sinkronisasi progres.
# Tanpa nilai ini fitur auth tetap bisa dilewati (progres hanya LocalStorage).
PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
PUBLIC_SUPABASE_ANON_KEY=
