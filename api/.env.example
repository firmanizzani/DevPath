# Supabase PostgreSQL — Settings → Database → Connection string (URI)
# Contoh: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0.xx.pooler.supabase.com:6543/postgres?sslmode=require
# Catatan: karakter '#' di password harus ditulis %23 agar parsing URL tidak rusak.
DATABASE_URL=

# Port API (harus sama dengan PUBLIC_API_URL di devpath/.env)
PORT=3001

# Supabase — Settings → API
# Dipakai backend untuk memverifikasi token akses (supabase.auth.getUser)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=
